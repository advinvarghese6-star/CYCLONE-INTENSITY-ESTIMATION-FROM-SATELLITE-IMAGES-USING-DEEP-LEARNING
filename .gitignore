# Credentials & Security (CRITICAL: Do NOT remove)
credentials.json
*.pem
*.key
.env
.env.*
!.env.example

# Node.js & Next.js
node_modules/
**/node_modules/
.next/
**/.next/
out/
build/
dist/
.vercel
*.tsbuildinfo
next-env.d.ts

# Python & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
*.egg-info/
.pytest_cache/

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
temp/
scratch/
.system_generated/

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini
